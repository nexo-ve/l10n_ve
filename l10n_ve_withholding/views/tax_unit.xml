<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_unit_list_l10n_ve_withholding" model="ir.ui.view">
        <field name="name">view.tax.unit.list.l10n_ve.payment.extension</field>
        <field name="model">tax.unit</field>
        <field name="arch" type="xml">
            <list string="Tax Units">
                <field name="name"/>
                <field name="value"/>
                <field name="status" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_tax_unit_form_l10n_ve_withholding" model="ir.ui.view">
        <field name="name">view.tax.unit.form.l10n_ve.payment.extension</field>
        <field name="model">tax.unit</field>
        <field name="arch" type="xml">
            <form string="Tax unit">
                <sheet string="Tax unit">
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="value"/>
                        </group>
                        <group>
                            <field name="status" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_search_tax_unit_l10n_ve_withholding" model="ir.ui.view">
        <field name="name">Tax unit</field>
        <field name="model">tax.unit</field>
        <field name="arch" type="xml">
            <search string="Tax unit">
                <field name="name"/>
                <field name="value"/>
                <filter name="active" domain="[('status','=',True)]" string="Active"/>
                <filter name="inactive" domain="[('status','=',False)]" string="Inactive"/>
                <separator/>
                <group>
                    <filter name="group_by_status" context="{'group_by': 'status'}" string="Status"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tax_unit_l10n_ve_withholding" model="ir.actions.act_window">
        <field name="name">Tax unit</field>
        <field name="res_model">tax.unit</field>
        <field name="type">ir.actions.act_window</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{"search_default_active":True}</field>
    </record>
</odoo>
