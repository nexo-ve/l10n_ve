<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <!-- Odoo 19 dropped the orders-table header row entirely, so there is
             no "Receipt Number" column title to relabel anymore. -->
        <xpath expr="//div[@class='control-buttons d-flex gap-2 pb-2']/button[last()]" position="replace">
            <button t-if="!isVenezuelaPos" class="control-button btn btn-light btn-lg lh-lg flex-grow-1 flex-shrink-1" t-on-click="() => doPrint.call(_selectedSyncedOrder)">
                <i t-attf-class="fa {{doPrint.status === 'loading' ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-print'}} me-1" />
                <t t-esc="ticketScreenSyncedPrintLabel"/>
            </button>
        </xpath>
    </t>
</templates>
