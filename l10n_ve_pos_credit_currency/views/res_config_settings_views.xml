<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_l10n_ve_pos_credit_currency" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n.ve.pos.credit.currency</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pos_default_journals']" position="after">
                <setting id="l10n_ve_pos_credit_invoice_currency"
                         string="Credit Invoice Currency"
                         groups="base.group_multi_currency"
                         help="Currency used for invoices of orders paid, in whole or in part, with a Customer Account (pay later) payment method">
                    <div class="content-group mt16">
                        <div class="row">
                            <label string="Company default" for="l10n_ve_company_pos_credit_invoice_currency_id" class="col-lg-3 o_light_label"/>
                            <field name="l10n_ve_company_pos_credit_invoice_currency_id" options="{'no_create': True}"/>
                        </div>
                        <div class="row">
                            <label string="This Point of Sale" for="l10n_ve_pos_credit_invoice_currency_id" class="col-lg-3 o_light_label"/>
                            <field name="l10n_ve_pos_credit_invoice_currency_id" options="{'no_create': True}"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
