<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_l10n_ve_seniat" model="ir.ui.view">
        <field name="name">res.config.settings.l10n.ve.seniat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='fiscal_localization_setting_container']"
                position="after"
            >
                <block
                    name="l10n_ve_seniat_block"
                    title="Venezuela - Tax Configuration"
                >
                    <div
                        id="l10n_ve_seniat_div_company_fiscal"
                        class="col-12 col-lg-6 o_setting_box"
                    >
                        <div class="o_setting_right_pane">
                            <separator string="Company Fiscal Info" />
                            <group>
                                <field name="taxpayer_type" string="Taxpayer Type" />
                                <!-- Art. 10 Ley del IVA; Art. 11 PA SNAT/2011/0071: facturación por terceros. -->
                                <field
                                    name="l10n_ve_on_behalf_of_third_party_enabled"
                                />
                                <!-- Art. 13 num. 5-7 PA SNAT/2011/0071: validación de RIF. -->
                                <field name="l10n_ve_validate_partner_vat_format" />
                                <field name="l10n_ve_lock_partner_fiscal_data" />
                                <field name="l10n_ve_enforce_sale_price_ge_cost" />
                            </group>
                        </div>
                    </div>
                    <div
                        id="l10n_ve_seniat_div_global_discount_accounts"
                        class="col-12 col-lg-6 o_setting_box"
                    >
                        <div class="o_setting_right_pane">
                            <separator string="Descuentos globales (contabilidad)" />
                            <div class="text-muted">
                                Cuenta contable donde se registra el monto del descuento
                                global en apuntes separados. También aplica a descuentos
                                por línea de factura.
                            </div>
                            <group class="mt-2">
                                <field
                                    name="account_discount_expense_allocation_id"
                                    string="Facturas de venta"
                                    placeholder="Misma cuenta que el producto"
                                />
                                <field
                                    name="account_discount_income_allocation_id"
                                    string="Facturas de compra"
                                    placeholder="Misma cuenta que el producto"
                                />
                            </group>
                        </div>
                    </div>
                    <div
                        id="l10n_ve_seniat_div_tax_groups"
                        class="col-12 col-lg-6 o_setting_box"
                    >
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Grupos de impuestos SENIAT</span>
                            <div class="text-muted">
                                Configure el tipo de alícuota y el orden de aparición
                                en los libros de ventas y compras desde los grupos de
                                impuestos.
                            </div>
                            <div class="mt-2">
                                <button
                                    name="action_open_l10n_ve_tax_groups"
                                    type="object"
                                    string="Configurar grupos de impuestos"
                                    class="btn-link"
                                    icon="oi-arrow-right"
                                />
                            </div>
                        </div>
                    </div>
                    <div
                        id="l10n_ve_seniat_div_implementer"
                        class="col-12 col-lg-6 o_setting_box"
                    >
                        <div class="o_setting_right_pane">
                            <separator string="Implementador del sistema" />
                            <!-- Art. 18-19 PA SNAT/2024/000102: datos del implementador autorizado. -->
                            <group>
                                <field name="l10n_ve_implementer_name" />
                                <field name="l10n_ve_implementer_vat" />
                                <field
                                    name="l10n_ve_implementer_email"
                                    placeholder="implementador@empresa.com"
                                />
                            </group>
                        </div>
                    </div>
                    <div
                        id="l10n_ve_seniat_div_dispatch_email"
                        class="col-12 col-lg-6 o_setting_box"
                    >
                        <div class="o_setting_right_pane">
                            <separator string="Guías de despacho no facturadas" />
                            <!-- Art. 21 PA SNAT/2011/0071; Art. 10 PA SNAT/2024/000102: reporte guías sin facturar. -->
                            <group>
                                <field
                                    name="l10n_ve_unfactured_dispatch_email_recipient"
                                    placeholder="proveedores.sistemas@seniat.gob.ve"
                                />
                                <field
                                    name="l10n_ve_unfactured_dispatch_email_schedule_enabled"
                                />
                                <label
                                    for="l10n_ve_unfactured_dispatch_email_interval_number"
                                    string="Enviar cada"
                                    invisible="not l10n_ve_unfactured_dispatch_email_schedule_enabled"
                                />
                                <div
                                    class="o_row"
                                    invisible="not l10n_ve_unfactured_dispatch_email_schedule_enabled"
                                >
                                    <field
                                        name="l10n_ve_unfactured_dispatch_email_interval_number"
                                        class="oe_inline"
                                    />
                                    <field
                                        name="l10n_ve_unfactured_dispatch_email_interval_type"
                                        class="oe_inline"
                                    />
                                </div>
                                <field
                                    name="l10n_ve_unfactured_dispatch_email_last_sent"
                                    readonly="1"
                                />
                            </group>
                        </div>
                    </div>
                </block>
                <block
                    id="l10n_ve_extended_localization_settings"
                    name="l10n_ve_extended_localization_settings"
                    title="Venezuela - Retenciones e IGTF"
                />
            </xpath>
        </field>
    </record>
</odoo>
