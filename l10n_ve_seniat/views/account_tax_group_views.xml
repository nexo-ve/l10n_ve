<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_tax_group_tree_l10n_ve_seniat" model="ir.ui.view">
        <field name="name">account.tax.group.list.l10n.ve.seniat</field>
        <field name="model">account.tax.group</field>
        <field name="inherit_id" ref="account.view_tax_group_tree" />
        <field name="arch" type="xml">
            <field name="preceding_subtotal" position="before">
                <field
                    name="l10n_ve_exclude_from_reports"
                    optional="show"
                    invisible="country_code != 'VE'"
                />
                <field
                    name="l10n_ve_aliquot_type"
                    optional="show"
                    invisible="country_code != 'VE' or l10n_ve_exclude_from_reports"
                />
            </field>
        </field>
    </record>

    <record id="view_tax_group_form_l10n_ve_seniat" model="ir.ui.view">
        <field name="name">account.tax.group.form.l10n.ve.seniat</field>
        <field name="model">account.tax.group</field>
        <field name="inherit_id" ref="account.view_tax_group_form" />
        <field name="arch" type="xml">
            <field name="sequence" position="after">
                <field name="country_code" invisible="1" />
                <field
                    name="l10n_ve_exclude_from_reports"
                    invisible="country_code != 'VE'"
                />
                <field
                    name="l10n_ve_aliquot_type"
                    invisible="country_code != 'VE' or l10n_ve_exclude_from_reports"
                />
            </field>
        </field>
    </record>
</odoo>
