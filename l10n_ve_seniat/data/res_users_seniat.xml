<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="partner_seniat" model="res.partner">
        <field name="name">SENIAT</field>
        <field name="vat">G200003030</field>
        <field name="email">seniat</field>
        <field
            name="image_1920"
            type="base64"
            file="l10n_ve_seniat/static/src/img/LogoSENIAT.png"
        />
        <field name="active" eval="True" />
    </record>

    <record id="user_seniat" model="res.users" context="{'no_reset_password': True}">
        <field name="partner_id" ref="partner_seniat" />
        <field name="login">seniat</field>
        <field name="password" />
        <field name="active" eval="True" />
        <field
            name="group_ids"
            eval="[
                Command.set([
                    ref('base.group_user'),
                    ref('account.group_account_readonly'),
                    ref('l10n_ve_seniat.group_seniat_readonly'),
                    ref('l10n_ve_seniat.group_seniat'),
                ])
            ]"
        />
    </record>
</odoo>
