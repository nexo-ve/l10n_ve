<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <!-- Odoo 19 renamed the generic point_of_sale.OrderWidget component (which
         took a `taxTotals` prop) to point_of_sale.OrderDisplay, which instead
         reads everything from its own `order` prop. Read `order.taxTotals`
         (patched below in models/pos_order.js) and reuse the component's own
         `formatCurrency` helper instead of the removed `taxTotals`/
         `formatMonetary` props. -->
    <t
        t-name="l10n_ve_loyalty_pos.OrderDisplay"
        t-inherit="point_of_sale.OrderDisplay"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//div[hasclass('order-summary')]/div[hasclass('d-flex') and hasclass('justify-content-between') and hasclass('w-100') and hasclass('fs-3')]"
            position="before"
        >
            <t t-if="order.taxTotals and order.taxTotals.l10n_ve_show_global_discount">
                <div class="d-flex justify-content-between w-100 fs-6 text-muted">
                    <span>Subtotal</span>
                    <span
                        t-esc="formatCurrency(order.taxTotals.order_sign * order.taxTotals.l10n_ve_subtotal_before_discount)"
                    />
                </div>
                <t
                    t-foreach="order.taxTotals.l10n_ve_global_discount_lines"
                    t-as="discountLine"
                    t-key="discountLine.id"
                >
                    <div class="d-flex justify-content-between w-100 fs-6 text-danger">
                        <span t-esc="discountLine.name"/>
                        <span
                            t-esc="formatCurrency(-order.taxTotals.order_sign * discountLine.amount)"
                        />
                    </div>
                </t>
            </t>
        </xpath>
    </t>
</templates>
