<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Odoo 19's client-side QWeb template registry does not support
         chaining a named extension (t-inherit-mode="extension") off of
         ANOTHER module's named extension as the t-inherit target: nowhere in
         Odoo 19 core or enterprise does any extension target another
         extension's own t-name (every one of them targets the real primary
         template). Doing so here made this whole template fail to register,
         which then surfaced downstream as "Missing (extension) parent
         templates: l10n_ve_pos.ReceiptScreen" and blocked the POS from
         leaving the loading screen. This xpath never actually depended on
         l10n_ve_pos's own injected markup (it targets the untouched core
         o_payment_successful/receipt-options divs), so inheriting directly
         from point_of_sale.ReceiptScreen instead needs no other change; both
         this and l10n_ve_pos's extension apply independently to the same
         core template, in module-dependency order, so the fiscal reprint
         button still lands right after l10n_ve_pos's invoice/control-number
         block and before the print/email options. -->
    <t t-name="l10n_ve_fiscal_serial_pos.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_payment_successful')]/div[hasclass('receipt-options')]" position="before">
            <button
                t-if="l10nVeShowFiscalReprint"
                type="button"
                class="btn btn-primary w-100 mt-2 py-2"
                t-att-disabled="l10nVeFiscalReprint.status === 'loading'"
                t-on-click="() => this.l10nVeFiscalReprint.call()"
            >
                <i t-attf-class="fa {{l10nVeFiscalReprint.status === 'loading' ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-print'}} me-1"/>
                <t t-esc="l10nVeFiscalReprintLabel"/>
            </button>
        </xpath>
    </t>
</templates>
